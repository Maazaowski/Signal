# ─────────────────────────────────────────────────────────────
#  Signal — local environment
#
#  Almost nothing lives here any more. API keys, mail credentials, the
#  schedule, the timezone, retention and crawl settings are all managed in
#  the app under Settings, and stored (secrets encrypted) in the database.
#
#  Editing this file has no effect on those — the database is the single
#  source of truth. Only the deployment-level values below are read here,
#  because they are needed before the database can be opened.
# ─────────────────────────────────────────────────────────────

# Where the server listens. Localhost only: Signal has no authentication,
# so binding 0.0.0.0 would expose every endpoint to your network.
HOST=127.0.0.1
PORT=8000

# Database location. Leave unset to use ./jobs.db next to the code.
# The test suite overrides this so it never touches your real data.
# JOBS_DB_PATH=
